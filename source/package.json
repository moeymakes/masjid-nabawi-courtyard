{
  "name": "nabawi-courtyard",
  "private": true,
  "description": "A walkable procedural world of the plaza of the Prophet's Mosque, rendered with WebGPU, bundled into one HTML file",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:readable": "node build.mjs --readable",
    "build:dev": "node build.mjs --dev",
    "capture": "node tools/capture.mjs ../dev.html --out ../verify/latest --size 2560x1440"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.49.1"
  }
}
